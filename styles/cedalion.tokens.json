{
 "$description": "Cedalion's figure design tokens, DTCG format 2025.10 (https://www.designtokens.org/tr/2025.10/format/). tools/tokens.py writes styles/<sheet>.mplstyle from `sheet`.",
 "palette": {
  "$type": "color",
  "$description": "Color schemes that no installed library provides.",
  "tol": {
   "$description": "Paul Tol, https://sronpersonalpages.nl/~pault/ (read 2026-11-22), in his order.",
   "bright": {
    "blue": { "$value": { "colorSpace": "srgb", "components": [ 0.2667, 0.4667, 0.6667 ], "hex": "#4477aa" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.4, 0.4667 ], "hex": "#ee6677" } },
    "green": { "$value": { "colorSpace": "srgb", "components": [ 0.1333, 0.5333, 0.2 ], "hex": "#228833" } },
    "yellow": { "$value": { "colorSpace": "srgb", "components": [ 0.8, 0.7333, 0.2667 ], "hex": "#ccbb44" } },
    "cyan": { "$value": { "colorSpace": "srgb", "components": [ 0.4, 0.8, 0.9333 ], "hex": "#66ccee" } },
    "purple": { "$value": { "colorSpace": "srgb", "components": [ 0.6667, 0.2, 0.4667 ], "hex": "#aa3377" } },
    "gray": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.7333, 0.7333 ], "hex": "#bbbbbb" } }
   },
   "high-contrast": {
    "blue": { "$value": { "colorSpace": "srgb", "components": [ 0.0, 0.2667, 0.5333 ], "hex": "#004488" } },
    "yellow": { "$value": { "colorSpace": "srgb", "components": [ 0.8667, 0.6667, 0.2 ], "hex": "#ddaa33" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.3333, 0.4 ], "hex": "#bb5566" } }
   },
   "vibrant": {
    "orange": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.4667, 0.2 ], "hex": "#ee7733" } },
    "blue": { "$value": { "colorSpace": "srgb", "components": [ 0.0, 0.4667, 0.7333 ], "hex": "#0077bb" } },
    "cyan": { "$value": { "colorSpace": "srgb", "components": [ 0.2, 0.7333, 0.9333 ], "hex": "#33bbee" } },
    "magenta": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.2, 0.4667 ], "hex": "#ee3377" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [ 0.8, 0.2, 0.0667 ], "hex": "#cc3311" } },
    "teal": { "$value": { "colorSpace": "srgb", "components": [ 0.0, 0.6, 0.5333 ], "hex": "#009988" } },
    "gray": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.7333, 0.7333 ], "hex": "#bbbbbb" } }
   },
   "muted": {
    "rose": { "$value": { "colorSpace": "srgb", "components": [ 0.8, 0.4, 0.4667 ], "hex": "#cc6677" } },
    "indigo": { "$value": { "colorSpace": "srgb", "components": [ 0.2, 0.1333, 0.5333 ], "hex": "#332288" } },
    "sand": { "$value": { "colorSpace": "srgb", "components": [ 0.8667, 0.8, 0.4667 ], "hex": "#ddcc77" } },
    "green": { "$value": { "colorSpace": "srgb", "components": [ 0.0667, 0.4667, 0.2 ], "hex": "#117733" } },
    "cyan": { "$value": { "colorSpace": "srgb", "components": [ 0.5333, 0.8, 0.9333 ], "hex": "#88ccee" } },
    "wine": { "$value": { "colorSpace": "srgb", "components": [ 0.5333, 0.1333, 0.3333 ], "hex": "#882255" } },
    "teal": { "$value": { "colorSpace": "srgb", "components": [ 0.2667, 0.6667, 0.6 ], "hex": "#44aa99" } },
    "olive": { "$value": { "colorSpace": "srgb", "components": [ 0.6, 0.6, 0.2 ], "hex": "#999933" } },
    "purple": { "$value": { "colorSpace": "srgb", "components": [ 0.6667, 0.2667, 0.6 ], "hex": "#aa4499" } }
   },
   "medium-contrast": {
    "light-blue": { "$value": { "colorSpace": "srgb", "components": [ 0.4, 0.6, 0.8 ], "hex": "#6699cc" } },
    "dark-blue": { "$value": { "colorSpace": "srgb", "components": [ 0.0, 0.2667, 0.5333 ], "hex": "#004488" } },
    "light-yellow": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.8, 0.4 ], "hex": "#eecc66" } },
    "dark-red": { "$value": { "colorSpace": "srgb", "components": [ 0.6, 0.2667, 0.3333 ], "hex": "#994455" } },
    "dark-yellow": { "$value": { "colorSpace": "srgb", "components": [ 0.6, 0.4667, 0.0 ], "hex": "#997700" } },
    "light-red": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.6, 0.6667 ], "hex": "#ee99aa" } }
   },
   "dark": {
    "blue": { "$value": { "colorSpace": "srgb", "components": [ 0.2667, 0.4667, 0.7333 ], "hex": "#4477bb" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [ 0.8, 0.2667, 0.4 ], "hex": "#cc4466" } },
    "green": { "$value": { "colorSpace": "srgb", "components": [ 0.1333, 0.5333, 0.2 ], "hex": "#228833" } },
    "sapphire": { "$value": { "colorSpace": "srgb", "components": [ 0.1333, 0.3333, 0.6667 ], "hex": "#2255aa" } },
    "maroon": { "$value": { "colorSpace": "srgb", "components": [ 0.6, 0.2, 0.4 ], "hex": "#993366" } },
    "pine": { "$value": { "colorSpace": "srgb", "components": [ 0.0, 0.4, 0.2667 ], "hex": "#006644" } },
    "teal": { "$value": { "colorSpace": "srgb", "components": [ 0.0667, 0.4667, 0.5333 ], "hex": "#117788" } },
    "purple": { "$value": { "colorSpace": "srgb", "components": [ 0.5333, 0.1333, 0.5333 ], "hex": "#882288" } },
    "magenta": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.2667, 0.5333 ], "hex": "#bb4488" } },
    "brown": { "$value": { "colorSpace": "srgb", "components": [ 0.4667, 0.3333, 0.0 ], "hex": "#775500" } },
    "gray": { "$value": { "colorSpace": "srgb", "components": [ 0.2667, 0.2667, 0.2667 ], "hex": "#444444" } }
   },
   "light": {
    "light-blue": { "$value": { "colorSpace": "srgb", "components": [ 0.4667, 0.6667, 0.8667 ], "hex": "#77aadd" } },
    "orange": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.5333, 0.4 ], "hex": "#ee8866" } },
    "light-yellow": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.8667, 0.5333 ], "hex": "#eedd88" } },
    "pink": { "$value": { "colorSpace": "srgb", "components": [ 1.0, 0.6667, 0.7333 ], "hex": "#ffaabb" } },
    "light-cyan": { "$value": { "colorSpace": "srgb", "components": [ 0.6, 0.8667, 1.0 ], "hex": "#99ddff" } },
    "mint": { "$value": { "colorSpace": "srgb", "components": [ 0.2667, 0.7333, 0.6 ], "hex": "#44bb99" } },
    "pear": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.8, 0.2 ], "hex": "#bbcc33" } },
    "olive": { "$value": { "colorSpace": "srgb", "components": [ 0.6667, 0.6667, 0.0 ], "hex": "#aaaa00" } },
    "pale-gray": { "$value": { "colorSpace": "srgb", "components": [ 0.8667, 0.8667, 0.8667 ], "hex": "#dddddd" } }
   },
   "pale": {
    "1": { "$value": { "colorSpace": "srgb", "components": [ 0.6667, 0.8, 0.9333 ], "hex": "#aaccee" } },
    "2": { "$value": { "colorSpace": "srgb", "components": [ 0.8, 0.9333, 1.0 ], "hex": "#cceeff" } },
    "3": { "$value": { "colorSpace": "srgb", "components": [ 0.7333, 0.8667, 0.7333 ], "hex": "#bbddbb" } },
    "4": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.9333, 0.7333 ], "hex": "#eeeebb" } },
    "5": { "$value": { "colorSpace": "srgb", "components": [ 1.0, 0.7333, 0.8 ], "hex": "#ffbbcc" } },
    "6": { "$value": { "colorSpace": "srgb", "components": [ 0.9333, 0.7333, 0.8667 ], "hex": "#eebbdd" } },
    "7": { "$value": { "colorSpace": "srgb", "components": [ 0.8667, 0.8667, 0.8667 ], "hex": "#dddddd" } }
   }
  }
 },
 "sheet": {
  "$description": "One group per Matplotlib sheet; the group path is the rc key. Lengths are px (CSS: 96 px = 72 pt) and become pt in the sheets.",
  "default": {
   "$extensions": {
    "org.cedalion.matplotlib": {
     "axes.spines.top": false,
     "axes.spines.right": false,
     "axes.prop_cycle": "cycler(color='petroff10')"
    }
   },
   "font": {
    "$type": "dimension",
    "size": { "$value": { "value": 8.0, "unit": "px" } },
    "family": {
     "$type": "fontFamily",
     "$value": "sans-serif"
    }
   },
   "axes": {
    "$type": "dimension",
    "titlesize": { "$value": { "value": 9.3333, "unit": "px" } },
    "linewidth": { "$value": { "value": 0.6667, "unit": "px" } }
   },
   "xtick": {
    "$type": "dimension",
    "major": {
     "size": { "$value": { "value": 2.6667, "unit": "px" } },
     "width": { "$value": { "value": 0.6667, "unit": "px" } }
    }
   },
   "ytick": {
    "$type": "dimension",
    "major": {
     "size": { "$value": { "value": 2.6667, "unit": "px" } },
     "width": { "$value": { "value": 0.6667, "unit": "px" } }
    }
   }
  },
  "elsevier": {
   "$description": "Elsevier artwork sizes (artwork and media instructions, accessed 2026-11-19).",
   "font": {
    "$type": "dimension",
    "size": { "$value": { "value": 9.3333, "unit": "px" }, "$description": "Normal text at its finished size: 7 pt (https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-sizing)." }
   },
   "axes": {
    "$type": "dimension",
    "linewidth": { "$value": { "value": 0.3333, "unit": "px" }, "$description": "Ordinary line work 0.25 pt, prominent plot lines about 1 pt (https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-faq)." }
   },
   "xtick": {
    "$type": "dimension",
    "major": {
     "width": { "$value": { "value": 0.3333, "unit": "px" } }
    }
   },
   "ytick": {
    "$type": "dimension",
    "major": {
     "width": { "$value": { "value": 0.3333, "unit": "px" } }
    }
   },
   "grid": {
    "$type": "dimension",
    "linewidth": { "$value": { "value": 0.3333, "unit": "px" } }
   },
   "patch": {
    "$type": "dimension",
    "linewidth": { "$value": { "value": 0.3333, "unit": "px" } }
   },
   "lines": {
    "$type": "dimension",
    "linewidth": { "$value": { "value": 1.3333, "unit": "px" } }
   }
  },
  "map": {
   "$description": "A frame marks the extent of each map panel and its insets.",
   "$extensions": {
    "org.cedalion.matplotlib": {
     "axes.spines.left": true,
     "axes.spines.right": true,
     "axes.spines.top": true,
     "axes.spines.bottom": true
    }
   }
  }
 }
}
