{
  "manifest_version": 2,
  "name": "Cedalion",
  "version": "0.1.0",
  "description": "Send selected Zotero items to a local Cedalion repository.",
  "applications": {
    "zotero": {
      "id": "cedalion@cedalion.local",
      "update_url": "https://github.com/inhouse-application/cedalion/releases/latest/download/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*"
    }
  }
}
